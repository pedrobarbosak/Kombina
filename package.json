{
  "name": "kombina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kombina: browser extension that finds the store where a whole KuantoKusta shopping list is cheapest.",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "web-ext lint",
    "start:firefox": "web-ext run",
    "start:chrome": "web-ext run --target chromium",
    "build": "node scripts/build.mjs",
    "stale": "node scripts/stale-stores.mjs 90",
    "lint:firefox": "npm run build -- firefox && web-ext lint --no-config-discovery -s dist/firefox"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "homepage": "https://github.com/pedrobarbosak/Kombina",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrobarbosak/Kombina.git"
  }
}
