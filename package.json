{
  "name": "kcompare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KCompare: browser extension that finds the store where a whole KuantoKusta shopping list is cheapest.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "web-ext lint",
    "start:firefox": "web-ext run",
    "start:chrome": "web-ext run --target chromium",
    "build": "web-ext build --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
